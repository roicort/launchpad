---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import Numbers from '../../components/Numbers.astro';
import Values from '../../components/Values.astro';
import Sponsors from '../../components/Sponsors.astro';
import Testimonials from '../../components/Testimonials.astro';
import { getSite } from '../../utils/consts';
const site = await getSite();
---

<PageLayout
	title={site.title}
>
	<Hero
		eyebrow="Un modèle Astro"
		title="Un socle Astro moderne pour les agences et studios."
		description="Lancez votre prochain projet avec une base solide, un blog, des vitrines projets et un mode sombre."
		actions={[
			{ label: 'Voir le blog', href: '/fr/blog' },
			{ label: 'Nous contacter', href: '/fr/about' },
		]}
	/>

	<Sponsors />

	<Numbers
		eyebrow="Résultats"
		title="Nous livrons avec constance"
		copy="Une stack design + code prête à livrer sans compromis sur la qualité."
		stats={[
			{ label: 'Projets livrés', value: '48', description: 'De la découverte à la mise en ligne sans friction.' },
			{ label: 'Délai moyen', value: '6 semaines', description: 'Petites équipes, cycles courts.' },
			{ label: 'NPS client', value: '72', description: 'Relations durables.' },
			{ label: 'Temps de réponse', value: '<24h', description: 'Slack, e-mail ou appel.' },
		]}
	/>

	<Values
		eyebrow="Valeurs"
		title="Notre manière de travailler"
		copy="Des principes concrets pour livrer chaque projet avec intention et exigence."
		values={[
			{ title: 'Clarté avant le bruit', description: 'Nous écrivons, concevons et développons pour être compris rapidement.' },
			{ title: 'Priorité à la livraison', description: 'Nous préférons des releases courtes et validées aux paris trop longs.' },
			{ title: 'Exigence pragmatique', description: 'La qualité compte quand elle sert le résultat.' },
			{ title: 'Esprit partenaire', description: 'Transparents, réactifs et fiables, comme une équipe embarquée.' },
		]}
	/>

	<PostList
		heading="Blog"
		limit={3}
		viewAllHref="/fr/blog"
	/>
		
	<Testimonials
		eyebrow="Témoignages"
		title="Ce que disent nos clients"
	/>

</PageLayout>
